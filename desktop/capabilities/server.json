{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "server",
  "description": "The studio UI, served by the app's own local server: its own window controls, and checking for and installing updates, saving files through the Save dialog; nothing else",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    "allow-install-update",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-appimage-location",
    "allow-move-to-applications",
    "allow-keep-here",
    "allow-set-launcher",
    "allow-save-file"
  ]
}
