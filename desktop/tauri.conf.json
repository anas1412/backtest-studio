{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backtest Studio",
  "version": "0.1.0",
  "identifier": "com.anas1412.backteststudio",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Backtest Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Write, backtest and run MT5 strategies with AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/studio-server"
    ],
    "resources": {
      "../web/dist/": "web/",
      "../workspace/AGENTS.md": "workspace/AGENTS.md",
      "../workspace/CLAUDE.md": "workspace/CLAUDE.md",
      "../workspace/GEMINI.md": "workspace/GEMINI.md",
      "../workspace/opencode.json": "workspace/opencode.json",
      "../workspace/tools/": "workspace/tools/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMTQ1NkRFOTBDOTA0RDYKUldUV0JNbVEzbFlVWWRMa2ZSTm56QUpOZzhJM2VIVHBhK296UlRZNmxVdkx1ZWtqUWh4QmRyS2oK",
      "endpoints": [
        "https://github.com/anas1412/backtest-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
